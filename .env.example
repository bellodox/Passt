# Passt env-var template.
# Copy to .env.local and fill in per-slice as integrations land.
# None of these are required for the current scaffold (slice 0).

# --- Supabase (EU region) ------------------------------------------------
# Added in slice 2 (auth + persistence).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Hetzner Object Storage (EU, S3-compatible) --------------------------
# Added in slice 1 (audio write path) and slice 2 (read path).
HETZNER_S3_ENDPOINT=
HETZNER_S3_REGION=
HETZNER_S3_ACCESS_KEY_ID=
HETZNER_S3_SECRET_ACCESS_KEY=
HETZNER_S3_BUCKET=

# --- OpenRouter (LLM + TTS) ---------------------------------------------
# Added in slice 1. Model IDs are defaults; override here if needed.
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=mistralai/mistral-large
OPENROUTER_TTS_MODEL=qwen/qwen-tts

# --- Stripe (subscriptions) ---------------------------------------------
# Added in slice 4.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Inngest (async generation jobs) ------------------------------------
# Added in slice 1 when the background worker lands.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
